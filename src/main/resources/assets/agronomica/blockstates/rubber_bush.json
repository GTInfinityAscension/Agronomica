{
  "multipart": [
    {
      "apply": {
        "model": "agronomica:block/crop_sticks"
      }
    },
    {
      "when": {
        "age": "0"
      },
      "apply": {
        "model": "agronomica:block/rubber_bush_stage0"
      }
    },
    {
      "when": {
        "age": "1"
      },
      "apply": {
        "model": "agronomica:block/rubber_bush_stage1"
      }
    },
    {
      "when": {
        "age": "2"
      },
      "apply": {
        "model": "agronomica:block/rubber_bush_stage2"
      }
    },
    {
      "when": {
        "age": "3"
      },
      "apply": {
        "model": "agronomica:block/rubber_bush_stage3"
      }
    }
  ]
}
